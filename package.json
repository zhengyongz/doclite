{
  "name": "doclite",
  "private": true,
  "version": "0.1.0",
  "description": "轻快文档工具箱 - Word/Excel/PPT/PDF 本地预览与格式转换",
  "author": "doclite",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron electron/main.js",
    "electron:build": "vite build && electron-builder --linux deb"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.doclite.app",
    "productName": "DocLite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "doclite <doclite@localhost>",
      "executableArgs": [
        "--no-sandbox"
      ],
      "desktop": {
        "Name": "轻快文档工具箱",
        "Name[en]": "DocLite",
        "Comment": "Word/Excel/PPT/PDF 本地预览与格式转换",
        "Icon": "doclite",
        "Categories": "Office;Utility;Viewer;",
        "Terminal": "false"
      }
    },
    "deb": {
      "packageName": "doclite",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true,
    "electron@33.4.11": true
  }
}
